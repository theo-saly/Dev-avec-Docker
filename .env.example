# Secrets de l'application : copier ce fichier en .env (jamais commité) et remplacer chaque valeur.
# Les réglages non secrets propres à chaque environnement sont dans env/test.env, env/uat.env, env/prod.env.

# ===== JWT (partagé par tous les services, 32 caractères minimum) =====
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire-32+

# ===== Symfony (auth-service) =====
APP_SECRET=remplacer-par-une-chaine-aleatoire

# ===== Compte administrateur créé au premier démarrage =====
ADMIN_EMAIL=admin@billetterie.local
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe

# ===== MySQL : root + un utilisateur par service =====
MYSQL_ROOT_PASSWORD=remplacer-root
AUTH_DB_PASSWORD=remplacer-auth
EVENT_DB_PASSWORD=remplacer-events
TICKET_DB_PASSWORD=remplacer-tickets

# ===== SMTP (optionnel : laisser vide pour seulement journaliser les notifications) =====
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_RECIPIENT=
